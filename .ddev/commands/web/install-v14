(3, 0, 1788780164, 1788779943, 0, 0, 1, 1, 0, 1, 'group0-groupdelegation-subadmin', 'readFolder,writeFolder,addFolder,renameFolder,moveFolder,deleteFolder,readFile,writeFile,addFile,renameFile,replaceFile,moveFile,copyFile,deleteFile', 'groupdelegation');

