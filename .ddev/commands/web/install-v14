(4, 0, 1788779900, 1788779900, 0, 0, 0, 'default-user', '$argon2i$v=19$m=65536,t=16,p=1$bjJES2Z2V3Fjb0hoc1V3bg$Mey4+j5kOpiOsWor6uFAcDMIZNxTnE1+4X1egVIEJfM', '', 'Max Mustermann', 'en', '');

INSERT INTO `be_groups` (`uid`, `pid`, `tstamp`, `crdate`, `deleted`, `hidden`, `tx_groupdelegation_delegateable`, `tx_groupdelegation_issubadmingroup`, `tx_groupdelegation_organisationunit`, `tx_groupdelegation_canactivate`, `title`, `file_permissions`, `groupMods`) VALUES
